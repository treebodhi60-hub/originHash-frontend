# Local development
VITE_API_BASE_URL=http://localhost:5000/api

# Production (Vercel): set this in the Vercel project's Environment Variables
# to your deployed Render backend URL, e.g.
# VITE_API_BASE_URL=https://originhash-backend.onrender.com/api

# The OriginHash superadmin's own login page (no leading slash needed). Nothing links to it and the
# public /login page doesn't accept the superadmin. Set your own value. Default: ohq-7c41e9
# VITE_SUPERADMIN_LOGIN_PATH=ohq-7c41e9
